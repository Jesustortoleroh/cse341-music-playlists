# Force TypeScript
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript

# Ignore ALL JavaScript files from language stats (including configs)
*.js linguist-vendored
eslint.config.js linguist-vendored
prettier.config.js linguist-vendored
package-lock.json linguist-vendored
swagger.json linguist-vendored

# Ignore compiled output and dependencies
dist/ linguist-vendored
dist/** linguist-generated=true
node_modules/ linguist-vendored