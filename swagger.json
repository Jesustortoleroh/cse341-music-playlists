{
  "swagger": "2.0",
  "info": {
    "title": "Music Playlists API",
    "description": "API for managing music playlists and users - CSE 341 Project",
    "version": "1.0.0"
  },
  "host": "cse341-music-playlists.onrender.com",
  "basePath": "/",
  "schemes": ["https"],
  "securityDefinitions": {
    "session": {
      "type": "apiKey",
      "in": "cookie",
      "name": "connect.sid",
      "description": "Session-based authentication. Login with GitHub or Google to get a secure session cookie."
    }
  },
  "paths": {
    "/auth/github": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Login with GitHub",
        "description": "Redirects the user to GitHub for OAuth 2.0 authentication.",
        "responses": {
          "302": { "description": "Redirect to GitHub" }
        }
      }
    },
    "/auth/google": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Login with Google",
        "description": "Redirects the user to Google for OAuth 2.0 authentication.",
        "responses": {
          "302": { "description": "Redirect to Google" }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get current user profile",
        "description": "Returns the authenticated user's profile data.",
        "security": [{ "session": [] }],
        "responses": {
          "200": { "description": "OK - User profile returned" },
          "401": { "description": "Unauthorized - Not logged in" }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Logout",
        "description": "Destroys the current user session.",
        "security": [{ "session": [] }],
        "responses": {
          "200": { "description": "OK - Logged out successfully" }
        }
      }
    },
    "/api/playlists": {
      "get": {
        "tags": ["Playlists"],
        "summary": "Get all playlists",
        "responses": {
          "200": {
            "description": "OK",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Playlist" } }
          },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "tags": ["Playlists"],
        "summary": "Create a new playlist",
        "security": [{ "session": [] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/PlaylistInput" }
          }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/Playlist" } },
          "400": { "description": "Bad Request - Validation Error" },
          "401": { "description": "Unauthorized - Must be logged in" }
        }
      }
    },
    "/api/playlists/{id}": {
      "get": {
        "tags": ["Playlists"],
        "summary": "Get playlist by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/Playlist" } },
          "400": { "description": "Invalid ID format" },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "tags": ["Playlists"],
        "summary": "Update a playlist",
        "security": [{ "session": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/PlaylistInput" }
          }
        ],
        "responses": {
          "204": { "description": "No Content - Updated successfully" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized - Must be logged in" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "tags": ["Playlists"],
        "summary": "Delete a playlist",
        "security": [{ "session": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": {
          "200": { "description": "OK - Deleted successfully" },
          "401": { "description": "Unauthorized - Must be logged in" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Get all users",
        "responses": {
          "200": {
            "description": "OK",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/User" } }
          },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create a new user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/UserInput" }
          }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/User" } },
          "400": { "description": "Bad Request - Validation Error" }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get user by ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": {
          "200": { "description": "OK", "schema": { "$ref": "#/definitions/User" } },
          "400": { "description": "Invalid ID format" },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update a user",
        "security": [{ "session": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/UserInput" }
          }
        ],
        "responses": {
          "204": { "description": "No Content - Updated successfully" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized - Must be logged in" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete a user",
        "security": [{ "session": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": {
          "200": { "description": "OK - Deleted successfully" },
          "401": { "description": "Unauthorized - Must be logged in" },
          "404": { "description": "Not Found" }
        }
      }
    }
  },
  "definitions": {
    "PlaylistInput": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "example": "My Awesome Playlist" },
        "description": { "type": "string", "example": "A collection of my favorite songs" },
        "creator": { "type": "string", "example": "Jesus Tortolero" },
        "genre": { "type": "string", "example": "jazz" },
        "songs": {
          "type": "array",
          "items": { "type": "string" },
          "example": ["Take Five - Dave Brubeck"]
        },
        "isPublic": { "type": "boolean", "example": true },
        "coverImage": { "type": "string", "example": "https://picsum.photos/400/400?random=10" }
      }
    },
    "Playlist": {
      "type": "object",
      "properties": {
        "_id": { "type": "string", "example": "66abc123def4567890abcdef" },
        "name": { "type": "string", "example": "My Awesome Playlist" },
        "description": { "type": "string", "example": "A collection of my favorite songs" },
        "creator": { "type": "string", "example": "Jesus Tortolero" },
        "genre": { "type": "string", "example": "jazz" },
        "songs": {
          "type": "array",
          "items": { "type": "string" },
          "example": ["Take Five - Dave Brubeck"]
        },
        "isPublic": { "type": "boolean", "example": true },
        "coverImage": { "type": "string", "example": "https://picsum.photos/400/400?random=10" },
        "createdAt": { "type": "string", "example": "2026-10-17T00:00:00.000Z" },
        "updatedAt": { "type": "string", "example": "2026-10-17T00:00:00.000Z" }
      }
    },
    "UserInput": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "example": "Jesus Tortolero" },
        "email": { "type": "string", "example": "jesus@example.com" },
        "password": { "type": "string", "example": "supersecretpassword" },
        "role": { "type": "string", "enum": ["user", "admin"], "example": "user" }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "_id": { "type": "string", "example": "66abc123def4567890abcdef" },
        "name": { "type": "string", "example": "Jesus Tortolero" },
        "email": { "type": "string", "example": "jesus@example.com" },
        "role": { "type": "string", "example": "user" },
        "provider": { "type": "string", "example": "github" },
        "createdAt": { "type": "string", "example": "2026-10-17T00:00:00.000Z" },
        "updatedAt": { "type": "string", "example": "2026-10-17T00:00:00.000Z" }
      }
    }
  }
}
